{
  "name": "baidu-marketing-api",
  "entrypoint": "scripts/bmctl.py",
  "runtime": {
    "python": ">=3.9",
    "python_min": [3, 9],
    "platforms": ["macos", "linux", "windows"],
    "dependencies": [],
    "interpreter": {
      "macos": "python3",
      "linux": "python3",
      "windows": "py -3"
    },
    "install_step": "无需安装：纯标准库实现，不需要 pip install",
    "network": "https://api.baidu.com",
    "local_ports": [8080]
  },
  "credentials_dir": "~/.workbuddy/baidu-marketing",
  "preflight": "scripts/bmctl.py 启动时会读取 runtime.python_min 校验解释器版本，低于门槛输出中文提示并退出码 6"
}
